; reolink2rtsp configuration
;
; Copy to reolink2rtsp.ini and fill in the camera passwords. The real file is
; gitignored; this example is safe to publish because it contains no camera
; credentials - only the RTSP-side test/test logins.
;
; Camera passwords must NOT be written here. Use ${ENV_VAR} and export the
; value, or put it in a separate file that is never committed:
;
;     export REOLINK_PASSWORD='your-camera-password'
;
; Any value supports ${VAR} and ${VAR:-fallback}.

[server]
; Address to listen on. 0.0.0.0 = every interface.
bind = 0.0.0.0

; Cameras that do not set rtsp_port explicitly get one from here, incrementing.
;
; 8554 is the default because it needs no privileges anywhere. 554 is the
; IANA-registered RTSP port (so clients can omit it from the URL), but on
; Linux/macOS anything below 1024 requires root. If you want 554, either
;   sudo setcap 'cap_net_bind_service=+ep' "$(readlink -f "$(which python3)")"
; or run under a service manager that binds the socket for you. Windows has no
; such restriction. reolink2rtsp fails with a clear message rather than a
; traceback if it cannot bind.
base_port = 8554

; RTP packet size. Lower it if you see loss over Wi-Fi or a VPN.
mtu = 1400

; How long DESCRIBE waits for the first key frame before returning 503.
describe_timeout = 20

log_level = INFO


[defaults]
; RTSP logins applied to any camera that does not list its own.
; Format: user:pass, separated by commas or newlines. Multiple pairs allowed.
users = RTSP_USER:RTSP_PASS


; --------------------------------------------------------------------------
; Cameras
;
; host       - camera IP (Baichuan / TCP 9000)
; username   - camera login (Reolink default is 'admin')
; password   - camera password: use ${ENV_VAR}, never a literal here
; stream     - which of the camera's three encodes to serve:
;                main   2560x1440  ~3.2 Mbit/s
;                extern  896x512   ~1.2 Mbit/s
;                sub     640x360   ~0.3 Mbit/s
;              All three are encoded by the camera anyway, so switching is free.
;              Run `reolink2rtsp encoder <host>` to see a camera's actual values.
; bitrate    - camera encoder bitrate in kbit/s (optional; persists on the camera)
; framerate  - camera encoder frame rate (optional; persists on the camera)
; gop        - camera key-frame interval (optional; persists on the camera)
; rtsp_port  - TCP port this camera is served on
; rtsp_path  - URL path; defaults to the section name
; users      - RTSP logins for this port (overrides [defaults])
; extra_streams - also publish these at /<path>/<stream>; default main,extern,sub
;                 set to "none" to publish only the configured stream
; always_on  - keep the camera connected even with no viewers
; audio      - serve the camera's AAC audio as a second RTSP track (default true)
; --------------------------------------------------------------------------

[camera:driveway]
host       = 192.0.2.10
username   = admin
password   = ${REOLINK_PASSWORD}
stream     = sub
rtsp_port  = 8554
users      = RTSP_USER:RTSP_PASS

[camera:side_gate]
host       = 192.0.2.12
username   = admin
password   = ${REOLINK_PASSWORD}
stream     = sub
rtsp_port  = 8555
users      = RTSP_USER:RTSP_PASS

[camera:back_door]
host       = 192.0.2.14
username   = admin
password   = ${REOLINK_PASSWORD}
stream     = sub
rtsp_port  = 8556
users      = RTSP_USER:RTSP_PASS


; --------------------------------------------------------------------------
; Currently offline - left here so they start working the moment they come back.
; Set enabled = true once the camera is reachable.
; --------------------------------------------------------------------------

[camera:back_yard]
enabled    = false
host       = 192.0.2.13
username   = admin
password   = ${REOLINK_PASSWORD}
stream     = sub
rtsp_port  = 8557
users      = RTSP_USER:RTSP_PASS

[camera:garage]
enabled    = false
host       = 192.0.2.11
username   = admin
password   = ${REOLINK_PASSWORD}
stream     = sub
rtsp_port  = 8558
users      = RTSP_USER:RTSP_PASS
